{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.38/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
    "window_hiding_behaviour": "Hide",
  "cross_monitor_move_behaviour": "Insert",
  "transparency": false,
  "transparency_alpha": 252,
  "default_workspace_padding": -1,
  "default_container_padding": 0,
  "border": true,
  "border_style":"Rounded",
  "border_width": 3,
  "border_offset": -1,
  "mouse_follows_focus": false,
  "animation": {
    "enabled": true,
    "duration": 240,
    "fps": 240,
    "style": "EaseInSine",
  },
  "border_colours": {
    "single": "#BFDBFE",
    "stack": "#BFDBFE",
    "unfocused": "#7a7c7d",
    "floating": "#BFDBFE",
    "monocle": "#b2b2b2"
  },
  "monitors": [
    // monitor 2, index 1
    {
      "workspaces": [
        {
          "name": "Home",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "4",
          "layout": "BSP"
        },
        {
          "name": "5",
          "layout": "BSP"
        },
      ]
    }
  ],
 "ignore_rules": [
{
"kind": "Exe",
"id": "ACShadows.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "Overwatch.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "Photos.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "PotPlayerMini64.exe",
"matching_strategy": "Equals",
},
{
"kind": "Exe",
"id": "AmneziaVPN.exe",
"matching_strategy": "Equals",
}
]
}
